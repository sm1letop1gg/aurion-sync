{
  "name": "aurion-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Discord-бот для переноса ролей и серверных ников Aurion между серверами",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/check-syntax.js",
